  m_TableData:
  - m_Id: 28323737600
    m_Localized: 'You defeated the otherworldly being

      and returned, only to
      be caught in

      the explosion of an unstable portal.


      As your consciousness
      fades,

      you sense a small presence approaching you.'
    m_Metadata:
      m_Items: []
  - m_Id: 30559301632
    m_Localized: 'You defeated the otherworldly being

      and returned, only to
      be caught in

      the explosion of an unstable portal.


      As your consciousness
      fades,

      you sense familiar presences approaching you.'
    m_Metadata:
      m_Items: []
  - m_Id: 32807448576
    m_Localized: 'You defeated the otherworldly being

      and returned, but the
      unstable portal

      erupts into an explosion.



      Just before you are
      engulfed,

      the fully purified sword begins to shine.'
    m_Metadata:
      m_Items: []
